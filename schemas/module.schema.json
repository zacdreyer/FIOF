{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FIOF module manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "coreCompatibility", "status", "requires"],
  "properties": {
    "id": { "type": "string", "pattern": "^(domain|product)\\.[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "kind": { "enum": ["domain", "product"] },
    "coreCompatibility": { "const": "0.1.x" },
    "status": { "enum": ["experimental", "validated", "deprecated"] },
    "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(domain|product)\\.[a-z0-9]+(-[a-z0-9]+)*$" } }
  }
}
